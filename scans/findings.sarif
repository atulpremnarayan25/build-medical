                        "text": "export const GET: RequestHandler = async ({ url, locals }) => {\n\tif (!locals.user || locals.user.role !== 'owner_admin') {\n\t\treturn json({ error: 'Forbidden: Admin role required' }, { status: 403 });\n\t}\n\n\tconst since = url.searchParams.get('since');"
                      }
                    }
                  ]
                }
              ],
              "description": {
                "text": "In `src/routes/api/sync/pull/+server.ts`, restrict access to `owner_admin` or a dedicated synchronization credential:\n```typescript\nif (!locals.user || locals.user.role !== 'owner_admin') {\n    return json({ error: 'Forbidden: Admin role required' }, { status: 403 });\n}\n```",
                "markdown": "In `src/routes/api/sync/pull/+server.ts`, restrict access to `owner_admin` or a dedicated synchronization credential:\n```typescript\nif (!locals.user || locals.user.role !== 'owner_admin') {\n    return json({ error: 'Forbidden: Admin role required' }, { status: 403 });\n}\n```"
              }
