ild-med-plans/03-TRD.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "sync_architecture", "label": "Store Server Sync Architecture", "nodes": ["build_med_plans_03_store_server_model", "build_med_plans_03_outbox_sync", "build_med_plans_03_delta_stock_reconciliation", "build_med_plans_06_sync_outbox_table", "build_med_plans_07_sync_api"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "build-med-plans/03-TRD.md"}]}