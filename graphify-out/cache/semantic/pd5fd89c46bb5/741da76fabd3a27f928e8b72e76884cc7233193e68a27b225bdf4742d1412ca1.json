{"nodes": [{"id": "build_med_plans_03_trd", "label": "Technical Requirements Document", "file_type": "document", "source_file": "build-med-plans/03-TRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_med_plans_03_store_server_model", "label": "Store Server Deployment Model", "file_type": "rationale", "source_file": "build-med-plans/03-TRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One designated always-on local machine runs the Node.js API and local PostgreSQL. All LAN devices talk directly to it. Rejected full multi-master (too complex N-way conflict resolution) and cloud-only (requires reliable internet which small-town UP cannot guarantee). This makes NFR-005 achievable."}, {"id": "build_med_plans_03_outbox_sync", "label": "Outbox Sync Pattern", "file_type": "rationale", "source_file": "build-med-plans/03-TRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every write is recorded as an entry in sync_outbox in the same transaction. Background sync worker pushes unsent entries to the other node with backoff. Guarantees no write is silently lost. Stock changes use deltas not absolute values to avoid overwrite conflicts."}, {"id": "build_med_plans_03_delta_stock_reconciliation", "label": "Delta-Based Stock Reconciliation", "file_type": "rationale", "source_file": "build-med-plans/03-TRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stock quantity changes applied as deltas (+/-), not absolute values. batch_stock_events is the source of truth, quantity_remaining is a maintained cache. Two concurrent sales against the same batch on different nodes both apply correctly."}, {"id": "build_med_plans_03_invoice_numbering", "label": "Invoice Numbering Strategy", "file_type": "rationale", "source_file": "build-med-plans/03-TRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-node reserved block of invoice numbers to prevent collisions across devices. Store Server owns numbering by default. Cloud node gets pre-allocated ranges. Format: INV-{store_code}-{node_id}-{sequence} or range reservation for GST compliance."}, {"id": "build_med_plans_03_optimistic_concurrency", "label": "Optimistic Concurrency Control", "file_type": "concept", "source_file": "build-med-plans/03-TRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_med_plans_03_postgresql", "label": "PostgreSQL Database", "file_type": "concept", "source_file": "build-med-plans/03-TRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_med_plans_03_nodejs_backend", "label": "Node.js TypeScript Backend", "file_type": "concept", "source_file": "build-med-plans/03-TRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "build_med_plans_03_trd", "target": "build_med_plans_03_store_server_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-med-plans/03-TRD.md", "source_location": null, "weight": 1.0}, {"source": "build_med_plans_03_trd", "target": "build_med_plans_03_outbox_sync", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-med-plans/03-TRD.md", "source_location": null, "weight": 1.0}, {"source": "build_med_plans_03_trd", "target": "build_med_plans_03_delta_stock_reconciliation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "build-med-plans/03-TRD.md", "source_location": null, "weight": 1.0}, {"source": "build_med_plans_03_trd", "target": "