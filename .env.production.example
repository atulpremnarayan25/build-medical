# ==============================================================================
# MedStock ERP — Production Environment Variables Template (OCI / Linux)
# Copy this file to .env on your OCI server: cp .env.production.example .env
# ==============================================================================

# Node runtime environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public Domain & SvelteKit CSRF Protection (MANDATORY)
# Must match the exact HTTPS domain you visit in the browser
APP_DOMAIN=erp.yourdomain.com
ORIGIN=https://erp.yourdomain.com

# Let's Encrypt automated TLS registration email
ACME_EMAIL=admin@yourdomain.com

# PostgreSQL Credentials (used by both Postgres container and SvelteKit app)
POSTGRES_USER=mederp_prod
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_RANDOM_PASSWORD_HERE
POSTGRES_DB=mederp_prod

# Connection Pool Tuning (Postgres.js)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
